# 复制本文件为 .env 后填写即可（.env 已被 .gitignore 忽略，不会泄露密钥）
# 也可以不建 .env，直接设置同名环境变量。

# ============ 模型接入（必填） ============
# 密钥：任意 OpenAI 兼容服务商均可
CODEAGENT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 服务端点（注意包含 /v1）
#   DeepSeek   : https://api.deepseek.com/v1
#   通义千问    : https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI     : https://api.openai.com/v1
#   Kimi       : https://api.moonshot.cn/v1
#   本地 Ollama : http://localhost:11434/v1
CODEAGENT_BASE_URL=https://api.deepseek.com/v1

# 模型名
#   deepseek-chat / qwen-plus / gpt-4o-mini / kimi-k2-0905-preview / qwen2.5-coder
CODEAGENT_MODEL=deepseek-chat

# ============ 可选参数（留空则使用默认值） ============
# CODEAGENT_TEMPERATURE=0.2
# CODEAGENT_MAX_TOKENS=4096
# CODEAGENT_TIMEOUT=120
# CODEAGENT_MAX_RETRIES=3
# CODEAGENT_STREAM=true

# Agent 行为
# CODEAGENT_MAX_STEPS=12
# CODEAGENT_MAX_TOOL_OUTPUT=12000
# CODEAGENT_CONTEXT_TOKEN_BUDGET=60000
# CODEAGENT_ALLOW_WRITE=true
# CODEAGENT_COMMAND_TIMEOUT=60
